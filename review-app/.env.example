# Copy this file to .env.local for development.

# Auth.js
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true

# Allowed Google login domain (no @). Cloud Run: set the same env var.
AUTH_ALLOWED_EMAIL_DOMAIN=naturalabs.io

# Local-only (npm run dev). Do not set on Cloud Run.
AUTH_DEV_BYPASS=true
AUTH_DEV_EMAIL=dev@naturalabs.io

# n8n ingest (persona workflows POST /api/inbox)
INGEST_SECRET=change-me

# Outbound: central n8n Webhook Production URL (Approve → Postbridge).
N8N_APPROVE_WEBHOOK=
N8N_DENY_WEBHOOK=

# json (local default) | firestore (Cloud Run default when K_SERVICE is set)
STORE=json
GOOGLE_CLOUD_PROJECT=
# FIRESTORE_DATABASE=(default)
